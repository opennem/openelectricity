# Vitest runs in Vite's `test` mode, which loads this file. SvelteKit 3 checks
# every variable declared in src/env.js when it starts, so a run without a
# `.env` (CI, a fresh clone) needs each required one set, even if blank.
# Unit tests mock what they use; nothing here is a real secret. A few get
# placeholders because code checks them on import: the Sanity client needs a
# project ID, its default dataset is `production`, and the OE client needs a key. Variables
# already in the environment (e.g. `doppler run --`) take precedence.
ARTICLE_LOGIN=
PUBLIC_JSON_API=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
PUBLIC_RECORDS_API=
PUBLIC_API_KEY=
CLOUDFLARE_WORKER_URL=
PUBLIC_JSON_URL=
PUBLIC_EMBER_BRIDGE_API=
PUBLIC_SANITY_PROJECT_ID=test
PUBLIC_SANITY_DATASET=production
SANITY_TOKEN=
PUBLIC_EXPLORE_URL=
PUBLIC_FEATURE_FLAGS=
PUBLIC_OE_API_KEY=test
PUBLIC_OE_API_URL=
PUBLIC_CLERK_PUBLISHABLE_KEY=
