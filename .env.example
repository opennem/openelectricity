# Base URL, for locking down proxied API requests
BASE_URL=openelectricity.localhost:7602

# Login for viewing draft articles
ARTICLE_LOGIN=

# Explore URL
PUBLIC_EXPLORE_URL=https://explore.opennem.org.au

# Sanity details
PUBLIC_SANITY_PROJECT_ID=''
PUBLIC_SANITY_DATASET=''
SANITY_TOKEN=''

# Records API
PUBLIC_RECORDS_API=''

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# JSONs
PUBLIC_JSON_URL=''
PUBLIC_JSON_API=''
PUBLIC_FLOWS_API=''
PUBLIC_EMISSIONS_API=''
PUBLIC_PRICE_API=''
PUBLIC_API_KEY=

# Ember Bridge API
PUBLIC_EMBER_BRIDGE_API=''

# Sanity CMS editing — Editor token (required for writes, datasets fetched dynamically)
SANITY_CMS_TOKEN=''

# Clerk Auth
PUBLIC_CLERK_PUBLISHABLE_KEY=''
CLERK_SECRET_KEY=''

# FEATURE FLAGS — flip values to true/false and restart the dev server (see docs/feature-flags.md)
PUBLIC_FEATURE_FLAGS='{
  "tracker2_nav": false,
  "facility_loads": false,
  "tracker_nav": false
}'

# ABS CPI updater only (optional; never exposed to the browser).
# Local chart development uses the bundled snapshot without these values.
# GitHub Actions uses repository variables for IDs and a repository secret for the token.
CLOUDFLARE_ACCOUNT_ID=
CPI_KV_NAMESPACE_ID=
CPI_CLOUDFLARE_API_TOKEN=

# Sentry user feedback ("Send feedback" in the navigation and a corner button).
# Optional: every feedback control stays hidden unless both are set. Use the
# public DSN of the Sentry project that should receive feedback; the switch
# must be exactly `true`. Read at runtime ($env/dynamic/public), so an unset
# value never breaks a build. Maintainers: set both in the Doppler config and
# the Cloudflare environment.
PUBLIC_SENTRY_DSN=
PUBLIC_FEEDBACK_ENABLED=
